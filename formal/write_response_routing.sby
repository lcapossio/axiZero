#
# SymbiYosys configuration — write response routing proof
#
# Verifies that B responses from AxiZeroMixedTop (MyFull_2M2S: 2M×2S, 64-bit)
# always return to the master that issued the corresponding AW.
#
# Usage (from formal/):
#   sby -f write_response_routing.sby
#
# Prerequisites: SymbiYosys + Yosys + z3
#   sudo apt install symbiyosys yosys z3
#
# The wrapper module (write_response_props.sv) instantiates the DUT and
# asserts the properties.  Free wires drive all DUT inputs so the solver
# explores all legal stimulus up to the proof depth.

[options]
# Bounded, not unbounded.  These properties are not inductive on their own:
# induction fails at step 0 because nothing relates the wrapper's transaction
# trackers to the crossbar's internal state, and supplying those strengthening
# invariants is a separate exercise.  Rather than claim a proof we do not have,
# check all behaviours exhaustively to a stated depth.
#
# Depth 20 is chosen for cost: solver time grows sharply past it (about 2
# minutes to reach step 20, then over a minute per step), and this runs on
# every CI job.
mode bmc
depth 20

[engines]
smtbmc z3

[script]
read -formal write_response_props.sv
read -formal MyFull_2M2S.v
prep -top write_response_props

[files]
write_response_props.sv
../generated/MyFull_2M2S.v
